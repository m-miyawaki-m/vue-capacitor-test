  <diagram id="poc-tests" name="PoC の合格条件と確認方法">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
